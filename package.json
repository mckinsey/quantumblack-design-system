  "name": "quantumblack-design-system",
  "version": "0.0.1-beta.1",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mckinsey/quantumblack-design-system"
  },
  "homepage": "https://github.com/mckinsey/quantumblack-design-system",
  "bugs": {
    "url": "https://github.com/mckinsey/quantumblack-design-system/issues"
  },
  "scripts": {
    "dev": "npm run assets:sync && npm run registry:build && vite --port 4123",
    "build": "npm run assets:build && npm run assets:sync && npm run registry:build && vite build",
    "assets:build": "npx @tailwindcss/cli -i src/styles/globals.css -o assets/css/qbds.css --minify && node -e \"const fs=require('fs');const p='assets/css/qbds.css';const b='/*! qbds.css — Auto-generated by npm run assets:build. Source: src/styles/globals.css (Tailwind CSS v4 CLI). Do not edit; changes are overwritten on build. */\\n';fs.writeFileSync(p,b+fs.readFileSync(p,'utf8'));\"",
    "assets:sync": "rm -rf public/assets && mkdir -p public/assets && cp -R assets/. public/assets/",
    "preview": "vite preview --port 4123",
    "registry:build": "npx shadcn@latest build && cp -R registry.json public/r/ && tsx scripts/inject-registry-urls.ts && concurrently --kill-others-on-fail \"npm run generate:api-docs\" \"npm run extract:examples\"",
    "generate:api-docs": "tsx scripts/generate-api-docs.ts",
    "extract:examples": "tsx scripts/extract-examples.ts",
    "tokens:check": "vitest run src/tests/tokens-from-docs.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "concurrently --kill-others-on-fail \"npm run test:unit\" \"npm run typecheck\" \"npm run build\" \"npm run lint\"",
    "typecheck": "tsc --noEmit",
    "lint": "concurrently --kill-others-on-fail -n eslint,prettier \"npm run lint:eslint\" \"npm run prettier\"",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache",
    "prettier": "prettier . --check --cache --cache-location .prettiercache",
    "prettier:fix": "prettier . --write --cache --cache-location .prettiercache",
    "secretscan": "scripts/secret-scan.sh",
    "precommit": "concurrently --kill-others-on-fail -n lint,typecheck,test,secrets \"npm run lint\" \"npm run typecheck\" \"npm run test:unit\" \"npm run secretscan\"",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "prepare": "husky && npm run skills:link",
    "skills:link": "symlink-dir .agents/skills/figma-parity .claude/skills/figma-parity && symlink-dir .agents/skills/figma-token-sync .claude/skills/figma-token-sync && symlink-dir .agents/skills/code-connect .claude/skills/code-connect",
    "figma:config": "tsx scripts/generate-figma-config.ts",
    "figma:publish": "npm run figma:config && figma connect publish --skip-validation"
  },
