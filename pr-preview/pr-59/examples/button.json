  {
    "name": "ButtonWithIcons",
    "code": "export function ButtonWithIcons() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-4\">\n      <Button>\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n        Leading Icon\n      </Button>\n      <Button>\n        Trailing Icon\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n    </div>\n  );\n}"
  },
  {
    "name": "ButtonLoading",
    "code": "export function ButtonLoading() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-4\">\n      <Button disabled className=\"w-[100px]\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"progress_activity\" className=\"animate-spin\" />\n        </IconShell>\n      </Button>\n      <Button variant=\"outline\" disabled className=\"w-[100px]\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"progress_activity\" className=\"animate-spin\" />\n        </IconShell>\n      </Button>\n      <Button variant=\"secondary\" disabled>\n        <IconShell size=\"sm\">\n          <Icon icon=\"progress_activity\" className=\"animate-spin\" />\n        </IconShell>\n        Loading...\n      </Button>\n    </div>\n  );\n}"
  },
  {
    "name": "ButtonIconOnly",
    "code": "export function ButtonIconOnly() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-4\">\n      <Button size=\"icon-lg\">\n        <IconShell size=\"default\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon-sm\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon-xs\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n    </div>\n  );\n}"
  },
  {
    "name": "ButtonIconRounded",
    "code": "export function ButtonIconRounded() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-4\">\n      <Button size=\"icon-lg\" className=\"rounded-full\">\n        <IconShell size=\"default\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon\" className=\"rounded-full\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon-sm\" className=\"rounded-full\" variant=\"outline\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n      <Button size=\"icon-xs\" className=\"rounded-full\" variant=\"ghost\">\n        <IconShell size=\"sm\">\n          <Icon icon=\"crop_free\" />\n        </IconShell>\n      </Button>\n    </div>\n  );\n}"
  },
  {
    "name": "ButtonGroups",
    "code": "export function ButtonGroups() {\n  return (\n    <div className=\"grid grid-cols-2 gap-x-8 gap-y-4\">\n      {/* Left column: secondary | secondary, secondary | ghost, default | secondary, default | ghost */}\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\">Button</Button>\n          <Button variant=\"secondary\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\">Button</Button>\n          <Button variant=\"ghost\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\">Button</Button>\n          <Button variant=\"secondary\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\">Button</Button>\n          <Button variant=\"ghost\">Button</Button>\n        </div>\n      </div>\n      {/* Right column: outline | secondary, ghost | secondary, outline | default, ghost | default */}\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"outline\">Button</Button>\n          <Button variant=\"secondary\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"ghost\">Button</Button>\n          <Button variant=\"secondary\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"outline\">Button</Button>\n          <Button variant=\"default\">Button</Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"ghost\">Button</Button>\n          <Button variant=\"default\">Button</Button>\n        </div>\n      </div>\n\n      {/* Accent + outline (left) | outline + accent (right, variants interchanged) */}\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"accent\">Button</Button>\n          <Button variant=\"outline\">Button</Button>\n        </div>\n      </div>\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"outline\">Button</Button>\n          <Button variant=\"accent\">Button</Button>\n        </div>\n      </div>\n\n      {/* Different sizes – default | secondary (left) | secondary | default (right, variants interchanged) */}\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\" size=\"xs\">\n            Button\n          </Button>\n          <Button variant=\"secondary\" size=\"xs\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\" size=\"sm\">\n            Button\n          </Button>\n          <Button variant=\"secondary\" size=\"sm\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\" size=\"default\">\n            Button\n          </Button>\n          <Button variant=\"secondary\" size=\"default\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"default\" size=\"lg\">\n            Button\n          </Button>\n          <Button variant=\"secondary\" size=\"lg\">\n            Button\n          </Button>\n        </div>\n      </div>\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\" size=\"xs\">\n            Button\n          </Button>\n          <Button variant=\"default\" size=\"xs\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\" size=\"sm\">\n            Button\n          </Button>\n          <Button variant=\"default\" size=\"sm\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\" size=\"default\">\n            Button\n          </Button>\n          <Button variant=\"default\" size=\"default\">\n            Button\n          </Button>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Button variant=\"secondary\" size=\"lg\">\n            Button\n          </Button>\n          <Button variant=\"default\" size=\"lg\">\n            Button\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n}"
  }
]
