{
  "codeConnect": {
    "parser": "react",
    "include": [
      "code-connect/*.figma.tsx",
      "code-connect/*.figma.ts",
      "src/components/**/*.tsx",
      "src/lib/**/*.ts"
    ],
    "exclude": ["**/node_modules/**"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "label": "React",
    "documentUrlSubstitutions": {}
  }
}
