[
  {
    "name": "DatePickerDemo",
    "code": "export function DatePickerDemo() {\n  const {\n    open,\n    setOpen,\n    date,\n    dateValue,\n    month,\n    setMonth,\n    handleInputChange,\n    handleCalendarSelect,\n  } = useDatePicker();\n\n  return (\n    <Field className=\"w-[196px] gap-2\">\n      <FieldLabel htmlFor=\"date-input\" className=\"label-regular-primary\">\n        Select Date\n      </FieldLabel>\n\n      <Popover open={open} onOpenChange={setOpen}>\n        <PopoverTrigger asChild>\n          <InputGroup data-open={open} className=\"cursor-pointer\">\n            <InputGroupInput\n              id=\"date-input\"\n              type=\"date\"\n              value={dateValue}\n              onChange={handleInputChange}\n              data-empty={dateValue ? 'false' : 'true'}\n              className={dateInputClassName}\n              aria-label=\"Date\"\n            />\n            <InputGroupAddon align=\"inline-end\">\n              <span className=\"flex size-5 cursor-pointer items-center justify-center\">\n                <IconShell size=\"sm\">\n                  <Icon\n                    icon=\"calendar_month\"\n                    className=\"text-[length:inherit]\"\n                  />\n                </IconShell>\n              </span>\n            </InputGroupAddon>\n          </InputGroup>\n        </PopoverTrigger>\n        <PopoverContent\n          className=\"w-auto overflow-hidden border-none p-0\"\n          align=\"start\"\n          sideOffset={4}\n          onOpenAutoFocus={e => e.preventDefault()}>\n          <Calendar\n            mode=\"single\"\n            selected={date}\n            month={month}\n            onMonthChange={setMonth}\n            onSelect={handleCalendarSelect}\n          />\n        </PopoverContent>\n      </Popover>\n\n      <FieldDescription>Helper text</FieldDescription>\n    </Field>\n  );\n}"
  },
  {
    "name": "DatePickerRange",
    "code": "export function DatePickerRange() {\n  const {\n    open,\n    setOpen,\n    startDateValue,\n    endDateValue,\n    month,\n    setMonth,\n    range,\n    handleStartInputChange,\n    handleEndInputChange,\n    handleSelect,\n    handleDayClick,\n  } = useDateRangePicker();\n\n  return (\n    <Field className=\"w-[240px] gap-2\">\n      <FieldLabel htmlFor=\"date-range-start\" className=\"label-regular-primary\">\n        Date Range\n      </FieldLabel>\n\n      <Popover open={open} onOpenChange={setOpen}>\n        <PopoverTrigger asChild>\n          <InputGroup data-open={open} className=\"cursor-pointer\">\n            <InputGroupInput\n              id=\"date-range-start\"\n              type=\"date\"\n              value={startDateValue}\n              onChange={handleStartInputChange}\n              data-empty={startDateValue ? 'false' : 'true'}\n              className={dateInputClassName}\n              aria-label=\"Start date\"\n            />\n            <InputGroupAddon className=\"order-none\">\n              <InputGroupText>\n                <Icon icon=\"arrow_forward\" className=\"text-[length:inherit]\" />\n              </InputGroupText>\n            </InputGroupAddon>\n            <InputGroupInput\n              id=\"date-range-end\"\n              type=\"date\"\n              value={endDateValue}\n              onChange={handleEndInputChange}\n              data-empty={endDateValue ? 'false' : 'true'}\n              className={dateInputClassName}\n              aria-label=\"End date\"\n            />\n            <InputGroupAddon align=\"inline-end\">\n              <span className=\"flex size-5 cursor-pointer items-center justify-center\">\n                <IconShell size=\"sm\">\n                  <Icon\n                    icon=\"calendar_month\"\n                    className=\"text-[length:inherit]\"\n                  />\n                </IconShell>\n              </span>\n            </InputGroupAddon>\n          </InputGroup>\n        </PopoverTrigger>\n        <PopoverContent\n          className=\"w-auto overflow-hidden border-none p-0\"\n          align=\"start\"\n          sideOffset={4}\n          onOpenAutoFocus={e => e.preventDefault()}>\n          <Calendar\n            mode=\"range\"\n            numberOfMonths={2}\n            selected={range}\n            month={month}\n            onMonthChange={setMonth}\n            onSelect={handleSelect}\n            onDayClick={handleDayClick}\n          />\n        </PopoverContent>\n      </Popover>\n\n      <FieldDescription>Helper text</FieldDescription>\n    </Field>\n  );\n}"
  },
  {
    "name": "DatePickerDisabled",
    "code": "export function DatePickerDisabled() {\n  return (\n    <Field className=\"w-[196px] gap-2\">\n      <FieldLabel\n        htmlFor=\"date-input-disabled\"\n        className=\"label-regular-primary\">\n        Select Date\n      </FieldLabel>\n\n      <InputGroup className=\"cursor-not-allowed\">\n        <InputGroupInput\n          id=\"date-input-disabled\"\n          type=\"date\"\n          value=\"\"\n          disabled\n          data-empty=\"true\"\n          className={dateInputClassName}\n          aria-label=\"Date\"\n        />\n        <InputGroupAddon align=\"inline-end\">\n          <span className=\"flex size-5 cursor-not-allowed items-center justify-center\">\n            <IconShell size=\"sm\">\n              <Icon icon=\"calendar_month\" className=\"text-[length:inherit]\" />\n            </IconShell>\n          </span>\n        </InputGroupAddon>\n      </InputGroup>\n\n      <FieldDescription>Helper text</FieldDescription>\n    </Field>\n  );\n}"
  },
  {
    "name": "DatePickerSizes",
    "code": "export function DatePickerSizes() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <DatePickerSized\n        size=\"sm\"\n        label=\"Small\"\n        labelClass=\"label-small-primary\"\n        descriptionClass=\"paragraph-small-primary\"\n        containerClass=\"w-[196px]\"\n      />\n      <DatePickerSized\n        size=\"default\"\n        label=\"Default\"\n        labelClass=\"label-regular-primary\"\n        containerClass=\"w-[196px]\"\n      />\n      <DatePickerSized\n        size=\"lg\"\n        label=\"Large\"\n        labelClass=\"label-large-primary\"\n        containerClass=\"w-[196px]\"\n      />\n    </div>\n  );\n}"
  },
  {
    "name": "DatePickerInlineSizes",
    "code": "export function DatePickerInlineSizes() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <DatePickerSized\n        variant=\"inline\"\n        size=\"sm\"\n        label=\"Small\"\n        labelClass=\"label-small-primary\"\n        descriptionClass=\"paragraph-small-primary\"\n        containerClass=\"w-[196px]\"\n      />\n      <DatePickerSized\n        variant=\"inline\"\n        size=\"default\"\n        label=\"Default\"\n        labelClass=\"label-regular-primary mb-[-4px]\"\n        containerClass=\"w-[196px]\"\n      />\n      <DatePickerSized\n        variant=\"inline\"\n        size=\"lg\"\n        label=\"Large\"\n        labelClass=\"label-large-primary mb-[-4px]\"\n        containerClass=\"w-[196px]\"\n      />\n    </div>\n  );\n}"
  },
  {
    "name": "DatePickerValidation",
    "code": "export function DatePickerValidation() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      <DatePickerValidationItem\n        id=\"error\"\n        label=\"Error\"\n        message=\"Feedback message here\"\n        messageClass=\"text-status-error\"\n        borderClass=\"\"\n        isError\n      />\n      <DatePickerValidationItem\n        id=\"warning\"\n        label=\"Warning\"\n        message=\"Feedback message here\"\n        messageClass=\"text-status-warning\"\n        borderClass=\"border border-status-warning\"\n        isError={false}\n      />\n      <DatePickerValidationItem\n        id=\"success\"\n        label=\"Success\"\n        message=\"Feedback message here\"\n        messageClass=\"text-status-success\"\n        borderClass=\"border border-status-success\"\n        isError={false}\n      />\n    </div>\n  );\n}"
  },
  {
    "name": "DatePickerRangeInline",
    "code": "export function DatePickerRangeInline() {\n  const {\n    open,\n    setOpen,\n    startDateValue,\n    endDateValue,\n    month,\n    setMonth,\n    range,\n    handleStartInputChange,\n    handleEndInputChange,\n    handleSelect,\n    handleDayClick,\n  } = useDateRangePicker();\n\n  return (\n    <Field className=\"w-[240px] gap-2\">\n      <FieldLabel\n        htmlFor=\"date-range-inline-start\"\n        className=\"label-regular-primary mb-[-4px]\">\n        Date Range\n      </FieldLabel>\n\n      <Popover open={open} onOpenChange={setOpen}>\n        <PopoverTrigger asChild>\n          <InputGroup\n            variant=\"inline\"\n            data-open={open}\n            className=\"cursor-pointer\">\n            <InputGroupInput\n              id=\"date-range-inline-start\"\n              type=\"date\"\n              variant=\"inline\"\n              value={startDateValue}\n              onChange={handleStartInputChange}\n              data-empty={startDateValue ? 'false' : 'true'}\n              className={dateInputClassName}\n              aria-label=\"Start date\"\n            />\n            <InputGroupAddon className=\"order-none\">\n              <InputGroupText>\n                <Icon icon=\"arrow_forward\" className=\"text-[length:inherit]\" />\n              </InputGroupText>\n            </InputGroupAddon>\n            <InputGroupInput\n              id=\"date-range-inline-end\"\n              type=\"date\"\n              variant=\"inline\"\n              value={endDateValue}\n              onChange={handleEndInputChange}\n              data-empty={endDateValue ? 'false' : 'true'}\n              className={dateInputClassName}\n              aria-label=\"End date\"\n            />\n            <InputGroupAddon align=\"inline-end\">\n              <span className=\"flex size-5 cursor-pointer items-center justify-center\">\n                <IconShell size=\"sm\">\n                  <Icon\n                    icon=\"calendar_month\"\n                    className=\"text-[length:inherit]\"\n                  />\n                </IconShell>\n              </span>\n            </InputGroupAddon>\n          </InputGroup>\n        </PopoverTrigger>\n        <PopoverContent\n          className=\"w-auto overflow-hidden border-none p-0\"\n          align=\"start\"\n          sideOffset={4}\n          onOpenAutoFocus={e => e.preventDefault()}>\n          <Calendar\n            mode=\"range\"\n            numberOfMonths={2}\n            selected={range}\n            month={month}\n            onMonthChange={setMonth}\n            onSelect={handleSelect}\n            onDayClick={handleDayClick}\n          />\n        </PopoverContent>\n      </Popover>\n\n      <FieldDescription>Helper text</FieldDescription>\n    </Field>\n  );\n}"
  }
]
